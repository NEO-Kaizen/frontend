# URL pública usada pelo navegador; inclua o base path da API quando houver.
PUBLIC_API_URL=http://localhost:3000

# URL privada usada pelo SSR para acessar diretamente o backend.
# Obrigatória quando a API pública usa a mesma origem do frontend.
API_INTERNAL_URL=http://127.0.0.1:3000

# Prefixo sob o qual o frontend é servido em produção (ex.: /server03). Vazio = raiz.
BASE_PATH=
