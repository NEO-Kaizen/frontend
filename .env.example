# URL pública usada pelo navegador; inclua o base path da API quando houver.
PUBLIC_API_URL=http://localhost:3000

# URL privada usada pelo SSR para acessar diretamente o backend.
# Obrigatória quando a API pública usa a mesma origem do frontend.
API_INTERNAL_URL=http://127.0.0.1:3000

# Prefixo sob o qual o frontend é servido em produção (ex.: /server03). Vazio = raiz.
# É lido no BUILD pelo vite.config.ts; mudar o valor exige novo build. Como o
# Vite também carrega .env no dev, prefira passá-lo na linha de comando no build.
BASE_PATH=

# Runtime do adapter-node, usado por `npm run start:prod` (sem efeito no `vite dev`).
# Descomente e ajuste conforme o proxy/VM de implantação (ver docs/05-Deploy.md).
# ORIGIN=https://example.org
# HOST=127.0.0.1
# PORT=4174
# BODY_SIZE_LIMIT=20M
