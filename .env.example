# URL base da API consumida pelo app.
#
# Desenvolvimento: API mock servida pelo middleware Vite sob /__mock (sem backend).
PUBLIC_API_URL=/__mock
#
# Backend real (produção / dev sem mock): descomente e aponte para a API.
# PUBLIC_API_URL=http://localhost:3000

# Backend real usado pelo proxy do mock em desenvolvimento para domínios
# desligados em src/lib/server/mocks/config.ts (MOCK_DOMAINS).
PUBLIC_REAL_API_URL=http://localhost:3000
