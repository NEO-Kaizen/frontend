{
	"$schema": "https://opencode.ai/config.json",
	"plugin": ["@sveltejs/opencode"],
	"permissions": {
		"bash": {
            "git *": "ask",

            "kill": "ask",
            "kill *": "ask",
            "pkill *": "ask",
            "killall *": "ask",

            "serve": "ask",
            "serve *": "ask",

            "pip *": "ask",
            "pip3 *": "ask",
            "cargo *": "ask",
            "apt": "ask",
            "apt *": "ask",
            "apt-get": "ask",
            "apt-get *": "ask",

            "rm": "ask",
            "rm *": "ask",
            "chmod *": "ask",
            "mv *": "ask",

            "npm install": "ask",
            "npm install *": "ask",
            "npm i": "ask",
            "npm i *": "ask",
            "npm ci": "ask",
            "npm ci *": "ask",
            "sudo *": "ask",

            "*env*": "deny",
            "*env.example*": "allow"
        }
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		}
	}
}
